{
  "name": "codexapp-official-web-host",
  "version": "0.1.0",
  "private": true,
  "description": "Version-locked browser host for the unmodified official ChatGPT/Codex desktop renderer.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "clean": "tsc -b --clean",
    "dev": "tsx apps/host/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/ensure-node-pty-helper.cjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "official:inspect": "tsx packages/official-package/src/cli.ts inspect",
    "official:extract": "tsx packages/official-package/src/cli.ts extract",
    "official:verify": "npm run build --silent && tsx packages/official-package/src/cli.ts verify",
    "official:prepare": "tsx packages/official-package/src/cli.ts prepare",
    "contracts:check": "npm run build --silent && tsx packages/browser-bridge/src/check-contract.ts",
    "security:check": "bash ops/check-source-boundaries.sh",
    "smoke:browser": "node scripts/smoke-browser-runtime.mjs",
    "smoke:desktop-tools": "node scripts/smoke-desktop-tools.mjs",
    "smoke:auth-isolation": "node scripts/smoke-auth-isolation.mjs",
    "smoke:approvals": "node scripts/smoke-approvals.mjs",
    "smoke:core-lifecycle": "node scripts/smoke-core-lifecycle.mjs",
    "smoke:host-persistence": "node scripts/smoke-host-persistence.mjs",
    "smoke:large-thread": "node scripts/smoke-large-thread.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:official-ui": "node scripts/smoke-official-ui.mjs",
    "smoke:task-start": "node scripts/smoke-task-start.mjs",
    "ci": "npm run security:check && npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@electron/asar": "4.2.1",
    "@fastify/websocket": "11.3.0",
    "better-sqlite3": "12.9.0",
    "capnweb": "0.10.0",
    "fastify": "5.10.0",
    "node-pty": "1.1.0",
    "pino": "10.3.1",
    "playwright-core": "1.58.2",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true,
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true
  }
}
