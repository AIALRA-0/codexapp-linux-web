[Unit]
Description=Keep only the latest verified CodexApp B rollback snapshot
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/codexapp-b-backup-retention
User=root
Group=root
UMask=0077
Nice=19
IOSchedulingClass=idle
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/aialra/backups/codexapp-b-upgrades /run/lock
NoNewPrivileges=true
