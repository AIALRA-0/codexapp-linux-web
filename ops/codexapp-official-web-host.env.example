NODE_ENV=production
HOST=127.0.0.1
PORT=13014
PUBLIC_ORIGIN=https://codexapp.aialra.online
TRUSTED_PROXY=127.0.0.1

OFFICIAL_SOURCE_ROOT=/srv/aialra/codexapp-official/current/source
OFFICIAL_ROOT=/srv/aialra/codexapp-official/current/source/webview
SOURCE_MANIFEST=/srv/aialra/codexapp-official/current/qualification/source-manifest.json
BROWSER_BRIDGE_SCRIPT=/srv/aialra/apps/codexapp-official-web-host/current/packages/browser-bridge/dist/index.js
ELECTRON_NET_BIN=/srv/aialra/codexapp-official/electron-runtime/43.2.0/node_modules/electron/dist/electron
ELECTRON_NET_WORKER=/srv/aialra/apps/codexapp-official-web-host/current/scripts/electron-net-worker.cjs
ELECTRON_NET_USER_DATA_DIR=/srv/aialra/state/codexapp-official/electron-network
ELECTRON_NET_EXPECTED_VERSION=43.2.0
ELECTRON_NET_EXPECTED_CHROMIUM_VERSION=150.0.7871.129
# The official Codex app-server uses this standard HTTP CONNECT proxy for
# OpenAI-owned hosts. Privoxy forwards only those hosts into local WARP.
HTTPS_PROXY=http://127.0.0.1:40001
NO_PROXY=127.0.0.1,localhost
# The worker uses Chromium's user-namespace sandbox because the service cannot
# gain privileges; it never uses Electron's --no-sandbox mode.
# Optional: credential-free loopback HTTP CONNECT proxy for the official
# ChatGPT projects-sidebar request when the pinned Electron network is unavailable.
# OPENAI_EGRESS_PROXY_URL=http://127.0.0.1:40000
EXPECTED_RENDERER_VERSION=26.730.61639
EXPECTED_CODEX_VERSION=codex-cli 0.147.0-alpha.1.2
EXPECTED_BUILD_NUMBER=6119
EXPECTED_BUILD_FLAVOR=prod
EXPECTED_APP_BRAND=chatgpt

RUNTIME_ROOT=/srv/aialra/state/codexapp-official
CODEX_BIN=/srv/aialra/codexapp-official/runtime-tools/node_modules/.bin/codex
BROWSER_EXECUTABLE=/usr/bin/google-chrome
# The unmodified shopping-browser plugin reads these variables by name from the
# host process. Its visible Chrome connects to the private Xvfb sidecar.
AIALRA_SHOPPING_BROWSER_PROFILE_DIR=/srv/aialra/state/codexapp-official/shopping-browser/profile
AIALRA_SHOPPING_BROWSER_OUTPUT_DIR=/srv/aialra/state/codexapp-official/shopping-browser/mcp
AIALRA_SHOPPING_BROWSER_BROWSER=chrome
AIALRA_SHOPPING_BROWSER_EXECUTABLE=/usr/bin/google-chrome
AIALRA_SHOPPING_BROWSER_KEEP_BROWSER_ALIVE=true
SESSION_SIGNING_KEY_FILE=/srv/aialra/config/secrets/codexapp-official-session.key
BRIDGE_RECONNECT_SECONDS=600
# The production service drop-in keeps one idle official engine warm for a day.
# This fallback remains useful for isolated smoke services that do not load it.
IDLE_RUNTIME_SECONDS=900

AUTH_SUBJECT_HEADER=X-Aialra-Sub
AUTH_HEADER=X-Aialra-User
AUTH_EMAIL_HEADER=X-Aialra-Email
AUTH_NAME_HEADER=X-Aialra-User
AUTH_GROUPS_HEADER=X-Aialra-Groups
AUTH_VERIFIED_HEADER=X-Aialra-Authenticated
AUTH_VERIFIED_VALUE=1
AUTH_PROXY_SECRET_HEADER=X-Aialra-Proxy-Secret
AUTH_PROXY_SECRET_FILE=/srv/aialra/config/secrets/codexapp-official-proxy-secret

MAX_SESSIONS=10
MAX_SESSIONS_PER_USER=4
STARTUP_THREAD_PREWARM_COUNT=1
MAX_BRIDGE_MESSAGES_PER_SECOND=500
MINIMUM_FREE_BYTES=5368709120
