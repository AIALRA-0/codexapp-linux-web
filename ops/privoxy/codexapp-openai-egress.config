# Loopback-only HTTP CONNECT bridge for the official Codex app-server.
# Only OpenAI-owned host suffixes use the Cloudflare WARP SOCKS endpoint.
# Every other destination keeps Privoxy's default direct route.
listen-address 127.0.0.1:40001
toggle 1
enable-remote-toggle 0
enable-edit-actions 0
enforce-blocks 1
accept-intercepted-requests 0
allow-cgi-request-crunching 0
split-large-forms 0
buffer-limit 4096
socket-timeout 90

forward-socks5t .chatgpt.com 127.0.0.1:40000 .
forward-socks5t .openai.com 127.0.0.1:40000 .
